# ===== Server =====
PORT=3001
# Comma-separated list of allowed frontend origins (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080

# ===== Supabase (Settings -> API) =====
# Use the SERVICE ROLE key here (server-side only, never in the frontend)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Session duration (milliseconds). Default: 30 days
SESSION_TTL_MS=2592000000

# ===== WhatsApp Cloud API (Meta) — optional =====
# Server-side Cloud API access token. Never expose this in the frontend.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_NEGOTIATION_TEMPLATE=new_price_offer
WHATSAPP_NEGOTIATION_RESPONSE_TEMPLATE=
WHATSAPP_NEGOTIATION_LANGUAGE=fr
APP_PUBLIC_URL=http://localhost:5173

# ===== AI Assistant =====
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# ===== Business rules =====
DELIVERY_FEE_TND=7
DELIVERY_REGIONS=Tunisie
DELIVERY_ESTIMATE=24 à 72 heures selon la région

# Used by the backend to authenticate admin dashboard sessions.
ADMIN_PASSWORD=
